+#[cfg(test)]
+mod borrowed_output_tests {
+    use super::*;
+    use std::io::Cursor;
+    // Every test closure is synchronous and does not retain or clone its stream.
+    fn output<W: Write + Seek, C: FnMut() -> std::io::Result<()>, T>(
+        sink: &mut W,
+        maximum: u64,
+        check: &mut C,
+        encode: impl FnOnce(&mut WMPStream) -> Result<T, WmpError>,
+    ) -> std::io::Result<Result<T, WmpError>> {
+        unsafe { with_ws_output(sink, maximum, check, encode) }
+    }
+    #[test]
+    fn capped_rewrites_stick_after_seek_failure() {
+        let mut sink = Cursor::new(Vec::new());
+        let result = output(&mut sink, 4, &mut || Ok(()), |stream| unsafe {
+            stream.Write.unwrap()(stream, &[1, 2, 3, 4])?;
+            stream.SetPos.unwrap()(stream, 1)?;
+            stream.Write.unwrap()(stream, &[9])?;
+            assert!(stream.SetPos.unwrap()(stream, 5).is_err());
+            assert!(stream.Write.unwrap()(stream, &[8]).is_err());
+            // Even a codec that swallowed both callback errors must fail.
+            Ok(())
+        });
+        assert!(result.is_err());
+        assert_eq!(sink.into_inner(), [1, 9, 3, 4]);
+    }
+    #[test]
+    fn addition_overflow_refuses_before_any_write() {
+        let mut sink = Cursor::new(Vec::new());
+        let result = output(
+            &mut sink,
+            usize::MAX as u64,
+            &mut || Ok(()),
+            |stream| unsafe {
+                stream.SetPos.unwrap()(stream, usize::MAX)?;
+                assert!(stream.Write.unwrap()(stream, &[1]).is_err());
+                assert!(stream.SetPos.unwrap()(stream, 0).is_err());
+                Ok(())
+            },
+        );
+        assert!(result.is_err());
+        assert!(sink.into_inner().is_empty());
+    }
+    #[test]
+    fn null_context_is_an_error_without_dereference() {
+        let mut stream = WMPStream::default();
+        let mut position = 0;
+        let result = unsafe {
+            get_pos_ws_output::<Cursor<Vec<u8>>, fn() -> std::io::Result<()>>(
+                &mut stream,
+                &mut position,
+            )
+        };
+        assert_eq!(result, Err(WmpError::FileIO));
+    }
+    #[test]
+    fn cancellation_after_encode_is_still_an_error() {
+        let mut sink = Cursor::new(Vec::new());
+        let mut calls = 0;
+        let result = output(
+            &mut sink,
+            4,
+            &mut || {
+                calls += 1;
+                if calls == 4 {
+                    Err(std::io::Error::new(
+                        std::io::ErrorKind::Interrupted,
+                        "late cancel",
+                    ))
+                } else {
+                    Ok(())
+                }
+            },
+            |_| Ok(()),
+        );
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::Interrupted);
+        assert!(sink.into_inner().is_empty());
+    }
+}
