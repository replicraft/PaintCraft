+// Private synchronous adapter. The encoder must be destroyed within `encode`;
+// neither WMPStream nor its erased borrowed context may escape that closure.
+// No extern-C callback is involved: WMPStream uses Rust function pointers.
+struct BorrowedOutput<'a, W, C> {
+    sink: &'a mut W,
+    check: &'a mut C,
+    position: u64,
+    extent: u64,
+    maximum: u64,
+    first_error: Option<std::io::Error>,
+}
+impl<W: Write + Seek, C: FnMut() -> std::io::Result<()>> BorrowedOutput<'_, W, C> {
+    fn fail(&mut self, error: std::io::Error) -> WmpError {
+        if self.first_error.is_none() {
+            self.first_error = Some(error);
+        }
+        WmpError::FileIO
+    }
+    fn poll(&mut self) -> Result<(), WmpError> {
+        if self.first_error.is_some() {
+            return Err(WmpError::FileIO);
+        }
+        match output_catch(|| (self.check)()) {
+            Ok(()) => Ok(()),
+            Err(error) => Err(self.fail(error)),
+        }
+    }
+    fn write(&mut self, bytes: &[u8]) -> Result<(), WmpError> {
+        self.poll()?;
+        let end = self
+            .position
+            .checked_add(bytes.len() as u64)
+            .filter(|end| *end <= self.maximum)
+            .ok_or_else(|| self.fail(std::io::Error::other("JPEG XR output extent limit")))?;
+        // On an inner partial write failure this is a conservative high-water
+        // bound. Sticky failure prevents any more sink operations afterward.
+        self.extent = self.extent.max(end);
+        match output_catch(|| self.sink.write_all(bytes)) {
+            Ok(()) => {
+                self.position = end;
+                Ok(())
+            }
+            Err(error) => Err(self.fail(error)),
+        }
+    }
+    fn seek(&mut self, position: u64) -> Result<(), WmpError> {
+        self.poll()?;
+        if position > self.maximum {
+            return Err(self.fail(std::io::Error::other("JPEG XR seek extent limit")));
+        }
+        match output_catch(|| self.sink.seek(SeekFrom::Start(position))) {
+            Ok(actual) if actual == position => {
+                self.position = position;
+                Ok(())
+            }
+            Ok(_) => Err(self.fail(std::io::Error::other(
+                "JPEG XR sink returned wrong position",
+            ))),
+            Err(error) => Err(self.fail(error)),
+        }
+    }
+}
+fn output_catch<T>(operation: impl FnOnce() -> std::io::Result<T>) -> std::io::Result<T> {
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(operation))
+        .map_err(|_| std::io::Error::other("JPEG XR output callback panicked"))?
+}
+/// # Safety
+/// The encode closure must destroy all encoder/stream clones and must not retain
+/// the borrowed stream or its context beyond its synchronous invocation.
+pub(crate) unsafe fn with_ws_output<W: Write + Seek, C: FnMut() -> std::io::Result<()>, T>(
+    sink: &mut W,
+    maximum: u64,
+    check: &mut C,
+    encode: impl FnOnce(&mut WMPStream) -> Result<T, WmpError>,
+) -> std::io::Result<Result<T, WmpError>> {
+    output_catch(&mut *check)?;
+    let initial = output_catch(|| sink.stream_position())?;
+    if initial != 0 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "JPEG XR sink must start at zero",
+        ));
+    }
+    output_catch(&mut *check)?;
+    let length = output_catch(|| sink.seek(SeekFrom::End(0)))?;
+    // Restore the caller cursor for a rejected nonempty sink if cancellation
+    // still allows seeking. No output bytes have been written.
+    output_catch(&mut *check)?;
+    let restored = output_catch(|| sink.seek(SeekFrom::Start(0)))?;
+    if restored != 0 || length != 0 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "JPEG XR sink must be empty",
+        ));
+    }
+    let mut context = BorrowedOutput {
+        sink,
+        check,
+        position: 0,
+        extent: 0,
+        maximum,
+        first_error: None,
+    };
+    let mut stream = WMPStream::default();
+    stream.state.pv_obj = Some(NonNull::from(&mut context).cast());
+    stream.Write = Some(write_ws_output::<W, C>);
+    stream.SetPos = Some(set_pos_ws_output::<W, C>);
+    stream.GetPos = Some(get_pos_ws_output::<W, C>);
+    // The context remains alive through encoder and stream drop, including
+    // early error return. Only function pointers, never borrowed closures, are
+    // stored by the codec. The private scope does not expose this raw stream.
+    let result = encode(&mut stream);
+    drop(stream);
+    if context.first_error.is_none() {
+        let _ = context.poll();
+    }
+    if context.first_error.is_none() && result.is_ok() {
+        if let Err(error) = output_catch(|| context.sink.flush()) {
+            context.fail(error);
+        }
+    }
+    match context.first_error.take() {
+        Some(error) => Err(error),
+        None => Ok(result),
+    }
+}
+unsafe fn output_context<'a, W, C>(
+    stream: &'a mut WMPStream,
+) -> Result<&'a mut BorrowedOutput<'a, W, C>, WmpError> {
+    let pointer = stream.state.pv_obj.ok_or(WmpError::FileIO)?;
+    // SAFETY: only with_ws_output installs these monomorphized functions and
+    // the live matching BorrowedOutput pointer. It cannot escape encode.
+    Ok(unsafe { &mut *pointer.cast::<BorrowedOutput<'a, W, C>>().as_ptr() })
+}
+unsafe fn write_ws_output<W: Write + Seek, C: FnMut() -> std::io::Result<()>>(
+    stream: &mut WMPStream,
+    bytes: &[u8],
+) -> Result<(), WmpError> {
+    unsafe { output_context::<W, C>(stream)? }.write(bytes)
+}
+unsafe fn set_pos_ws_output<W: Write + Seek, C: FnMut() -> std::io::Result<()>>(
+    stream: &mut WMPStream,
+    position: usize,
+) -> Result<(), WmpError> {
+    unsafe { output_context::<W, C>(stream)? }.seek(position as u64)
+}
+unsafe fn get_pos_ws_output<W: Write + Seek, C: FnMut() -> std::io::Result<()>>(
+    stream: &mut WMPStream,
+    position: &mut usize,
+) -> Result<(), WmpError> {
+    let context = unsafe { output_context::<W, C>(stream)? };
+    context.poll()?;
+    *position = usize::try_from(context.position)
+        .map_err(|_| context.fail(std::io::Error::other("JPEG XR position overflow")))?;
+    Ok(())
+}
