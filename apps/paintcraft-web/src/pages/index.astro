---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Untitled - PaintCraft</title>
		<link rel="icon" href="./favicon.ico" sizes="16x16 32x32 48x48 256x256">
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="./icons/paintcraft-icon-32.png"
		>
		<link
			rel="icon"
			type="image/png"
			sizes="192x192"
			href="./icons/paintcraft-icon-192.png"
		>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="./icons/paintcraft-icon-180.png"
		>
		<link rel="manifest" href="./paintcraft.webmanifest">
		<meta name="theme-color" content="#272727">
	</head>
	<body>
		<canvas id="paintcraft" aria-label="PaintCraft Classic canvas"></canvas>
		<div id="loading" role="status">Loading PaintCraft Web…</div>
		<noscript>PaintCraft Web requires JavaScript and WebAssembly.</noscript>
		<script>
		const status = document.getElementById('loading');
		let app;
		try {
			const [{ WebHandle, install_cjk_fonts }, { loadCjkFonts }] =
				await Promise.all([
					import('../../pkg/paintcraft_web.js'),
					import('../lib/fonts.js'),
				]);
			const fonts = await loadCjkFonts();
			install_cjk_fonts(fonts[0], fonts[1]);
			app = new WebHandle();
			window.paintcraft = app;
			await app.start(document.getElementById('paintcraft'));
			status.hidden = true;
			window.addEventListener('beforeunload', (event) => {
				if (app.is_dirty()) {
					event.preventDefault();
					event.returnValue = '';
				}
			});
			window.addEventListener('pagehide', (event) => {
				if (!event.persisted) app.destroy();
			});
		} catch (error) {
			app?.destroy();
			status.textContent = `PaintCraft could not start. PaintCraft needs WebAssembly and WebGPU or WebGL. ${error}`;
			console.error(error);
		}
		</script>
	</body>
</html>
