	"type": "object",
	"properties": {
		"schema": {
			"const": "paintcraft.file-command/v5"
		},
		"engine": {
			"$ref": "#/$defs/engine_result"
		},
		"file": {
			"anyOf": [
				{
					"$ref": "#/$defs/file_receipt"
				},
				{
					"type": "null"
				}
			]
		},
		"outcome": {
			"enum": [
				"success",
				"engine-rejected",
				"file-incomplete"
			]
		},
		"exit_code": {
			"type": "integer",
			"minimum": 0,
			"maximum": 6
		},
		"synthetic": {
			"type": "boolean"
		}
	},
	"required": [
		"schema",
		"engine",
		"file",
		"outcome",
		"exit_code",
		"synthetic"
	],
	"additionalProperties": false,
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:paintcraft:schema:layer-appearance-v1:8b05904f87725d78058f48a148e0af2ab0a2536dc369c052179edffa86e0c676:file-command",
	"title": "PaintCraft layer appearance file-command"
}
