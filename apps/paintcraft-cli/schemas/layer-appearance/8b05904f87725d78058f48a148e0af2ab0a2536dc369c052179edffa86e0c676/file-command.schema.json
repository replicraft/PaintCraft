		"engine_error": {
			"type": "object",
			"properties": {
				"schema": {
					"const": "paintcraft.error/v1"
				},
				"committed": {
					"const": false
				},
				"code": {
					"enum": [
						"input.schema",
						"policy.unknown",
						"reference.unknown_alias",
						"reference.unknown_id",
						"target.invalid",
						"capability.unsupported",
						"conflict.stale_base",
						"resource.limit",
						"operation.cancelled",
						"codec.failed",
						"storage.failed",
						"invariant.violation"
					]
				},
				"message": {
					"type": "string",
					"maxLength": 4096
				},
				"operation_index": {
					"type": "integer",
					"minimum": 0
