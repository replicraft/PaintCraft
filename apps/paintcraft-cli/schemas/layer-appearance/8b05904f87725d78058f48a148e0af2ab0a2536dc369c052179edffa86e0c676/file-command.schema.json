			},
			"required": [
				"schema",
				"committed",
				"code",
				"message"
			],
			"additionalProperties": false
		},
		"file_receipt": {
			"type": "object",
			"properties": {
				"schema": {
					"const": "paintcraft.file-operation/v1"
				},
				"operation_id": {
					"type": "string",
					"format": "uuid"
				},
				"operation": {
					"enum": [
						"save",
						"save-as",
						"save-copy",
						"export",
						"migrate-copy"
					]
				},
				"source_state_id": {
					"type": "string",
					"format": "uuid"
				},
				"source_sha256": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						},
						{
							"type": "null"
						}
					]
				},
				"destination_id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"save_sequence": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$"
				},
				"binding_generation": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$"
				},
				"replacement": {
					"enum": [
						"not-attempted",
						"not-replaced",
						"replaced",
						"unknown"
					]
				},
				"requested_durability": {
					"enum": [
						"best-effort",
						"durable"
					]
				},
				"durability": {
					"enum": [
						"not-requested",
						"not-confirmed",
						"confirmed"
					]
				},
				"staged_sha256": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						},
						{
							"type": "null"
						}
					]
				},
				"observed_destination_sha256": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						},
						{
							"type": "null"
						}
					]
				},
				"acknowledged_state_id": {
					"anyOf": [
						{
							"type": "string",
							"format": "uuid"
						},
						{
							"type": "null"
						}
					]
				},
				"source_lineage_adopted": {
					"const": false
				},
				"retry": {
					"enum": [
						"allowed-new-request",
						"inspect",
						"no-automatic-retry"
					]
				},
				"losses_acknowledged": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"minItems": 0,
					"maxItems": 128,
					"uniqueItems": true
				},
				"reasons": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"minItems": 0,
					"maxItems": 64,
					"uniqueItems": true
				},
				"synthetic": {
					"type": "boolean"
				}
			},
			"required": [
				"schema",
				"operation_id",
				"operation",
				"source_state_id",
				"source_sha256",
				"destination_id",
				"save_sequence",
				"binding_generation",
				"replacement",
				"requested_durability",
				"durability",
				"staged_sha256",
				"observed_destination_sha256",
				"acknowledged_state_id",
				"source_lineage_adopted",
				"retry",
				"losses_acknowledged",
				"reasons",
				"synthetic"
			],
			"additionalProperties": false
		}
