{
  "type": "object",
  "properties": {
    "schema": {
      "const": "paintcraft.mcp-inspect/v2"
    },
    "document_features": {
      "oneOf": [
        {
          "const": [
            "layer-point-filters.v1",
            "layer-filter-masks.v1"
          ]
        },
        {
          "const": [
            "layer-point-filters.v1",
            "layer-filter-masks.v1",
            "source-metadata.v1"
          ]
        }
      ]
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "state_id": {
      "type": "string",
      "format": "uuid"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "dirty": {
      "type": "boolean"
    },
    "undo_depth": {
      "type": "integer",
      "minimum": 0
    },
    "redo_depth": {
      "type": "integer",
      "minimum": 0
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "filters": {
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "enabled": {
                  "type": "boolean"
                },
                "descriptor": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "invert-rgb-v1"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "brightness-contrast-v1"
                        },
                        "brightness": {
                          "type": "integer",
                          "minimum": -100,
                          "maximum": 100
                        },
                        "contrast": {
                          "type": "integer",
                          "minimum": -99,
                          "maximum": 99
                        }
                      },
                      "required": [
                        "kind",
                        "brightness",
                        "contrast"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "mask": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "const": "a8-bands/v1"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "domain": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "integer",
                        "minimum": -140737488355327,
                        "maximum": 140737488355327
                      }
                    },
                    "bands": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 262144
                    },
                    "runs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 262144
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "schema",
                    "enabled",
                    "domain",
                    "bands",
                    "runs",
                    "digest"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "enabled",
                "descriptor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "visible",
          "opacity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "document_features",
    "document_id",
    "state_id",
    "width",
    "height",
    "dirty",
    "undo_depth",
    "redo_depth",
    "layers"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paintcraft:schema:mcp-inspect-v2"
}
