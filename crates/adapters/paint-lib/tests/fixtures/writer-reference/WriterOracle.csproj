<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(UpstreamRoot)/src/MsPaintFile/**/*.cs" Exclude="$(UpstreamRoot)/src/MsPaintFile/obj/**;$(UpstreamRoot)/src/MsPaintFile/bin/**" />
        <Compile Include="Program.cs" />
    </ItemGroup>
    <Target Name="RequirePinnedSource" BeforeTargets="CoreCompile">
        <Error Condition="'$(UpstreamRoot)' == ''" Text="Set UpstreamRoot to the verified pinned mspaintlib source tree." />
    </Target>
</Project>
